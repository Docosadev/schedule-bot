{
  "name": "discord-schedule-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord schedule polling bot with reaction voting.",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "commands:register": "tsx src/registerCommands.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "better-sqlite3": "^11.8.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "pg": "^8.22.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
